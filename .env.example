# Server
NODE_ENV=development
PORT=3000

# Frontend URL (for OAuth redirect and CORS). No trailing slash.
# e.g. http://localhost:3001 for Next.js dev
FRONTEND_URL=http://localhost:3001

# Google OAuth (create app at https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Session (generate a random string, e.g. openssl rand -base64 32)
SESSION_SECRET=your_session_secret_min_32_chars

# PostgreSQL (defaults match docker-compose.yml)
DATABASE_URL=postgresql://job_tracker:job_tracker_secret@localhost:5432/job_tracker

# Redis (for BullMQ)
REDIS_URL=redis://localhost:6379
